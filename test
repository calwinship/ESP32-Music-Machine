#!/bin/zsh
# Host unit tests (no board, no ESP-IDF needed). Usage: ./test
#   1. components/logic (C, ASan + UBSan)   2. tools/sync_tunes.py (Python stdlib unittest)
set -euo pipefail
cd "${0:A:h}"
mkdir -p build-host
cc -std=c11 -Wall -Wextra -Werror -pedantic -g -O1 -fsanitize=address,undefined -fno-omit-frame-pointer \
   -I firmware/s3/components/logic/include \
   tests/host/test_logic.c firmware/s3/components/logic/*.c \
   -o build-host/test_logic
./build-host/test_logic
PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests/host -p 'test_*.py'

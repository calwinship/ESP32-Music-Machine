#!/bin/zsh
# Host unit tests (no board, no ESP-IDF needed). Usage: ./test
#   1. components/logic (C, ASan + UBSan): one binary per tests/host/test_*.c
#   2. tools/sync_tunes.py (Python stdlib unittest)
set -euo pipefail
cd "${0:A:h}"
mkdir -p build-host
for t in tests/host/test_*.c; do
  bin="build-host/${${t:t}%.c}"
  cc -std=c11 -Wall -Wextra -Werror -pedantic -g -O1 -fsanitize=address,undefined -fno-omit-frame-pointer \
     -I firmware/s3/components/logic/include "$t" firmware/s3/components/logic/*.c -o "$bin"
  printf '%s: ' "${t:t}"
  "$bin"
done
PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests/host -p 'test_*.py'
